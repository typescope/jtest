import jo.IO.stdout
import jo.IO.args
import jtest.Runner
import jtest.Testing
import jtest.test
import jtest.thisSuite
import jtest.check

def main(): Unit receives stdout, args =
  val root = Testing.define("expected failure", () => failingTest())
  Runner.runWithArgs(root)

private def failingTest(): Unit receives thisSuite =
  test("intentional failure", () => check("intentional", false))
